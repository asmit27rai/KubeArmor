{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "constraints": {
    "go": "1.22"
  },
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "ignorePresets": [
    ":prHourlyLimit2"
  ],
  "reviewers": [
    "team:maintainers"
  ],
  "labels": [
    "dependencies",
    "security"
  ],
  "rangeStrategy": "auto",
  "prConcurrentLimit": 10,
  "dependencyDashboard": true
}